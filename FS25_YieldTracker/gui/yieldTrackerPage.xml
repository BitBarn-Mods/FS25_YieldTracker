<?xml version="1.0" encoding="utf-8" standalone="no"?>
<GUI name="YieldTrackerPage" returnScreenCallback="onClickBack">
    <GuiElement profile="fs25_menuContainer">

        <GuiElement profile="fs25_menuHeaderPanel" size="0.805 0.1" position="0.0 0.074">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="yieldTrackerMenuHeaderIcon" id="pageHeaderIcon"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="categoryHeaderText" text="$l10n_yt_modName"/>
        </GuiElement>

        <ThreePartBitmap profile="highlightedSeperator" size="0.83 0.003"/>

        <!--
            Important:
            This root uses the same base positioning as the working TSStockCheck page:
            fs25_statisticsHeaderBox. A raw GuiElement without this profile is anchored
            differently and caused the whole content grid to appear too far right.
        -->
        <GuiElement profile="yieldTrackerContentRoot">

            <!-- LEFT HALF: field + crop selection -->
            <GuiElement size="0.405 0.66" position="0.000 -0.455">

                <GuiElement profile="statsBoxHeader" size="0.405 0.035" position="0.000 0.000">
                    <Button profile="taskListHeader" position="0.000 0.000" size="0.195 1" text="$l10n_yt_selectFieldLabel" textAlignment="center" handleFocus="false"/>
                    <Button profile="taskListHeader" position="0.210 0.000" size="0.195 1" text="$l10n_yt_selectCropLabel" textAlignment="center" handleFocus="false"/>
                    <ThreePartBitmap profile="nonHighlightedSeperator"/>
                </GuiElement>

                <GuiElement profile="fieldIDListContainer" position="0.000 -0.045" size="0.195 0.615">
                    <SmoothList id="farmlandList" size="100% 100%" visible="true">
                        <ListItem profile="yieldTrackerListItem" name="default" onClick="onClickFieldSelected">
                            <Text profile="itemListText" name="fieldIDListText" textAlignment="center" textVerticalAlignment="center" position="0 0" size="100% 100%"/>
                        </ListItem>
                    </SmoothList>
                    <ThreePartBitmap profile="taskListGroupsSliderBox">
                        <Slider profile="fs25_listSlider" dataElementId="farmlandList"/>
                    </ThreePartBitmap>
                </GuiElement>

                <GuiElement profile="cropSelectionContainer" position="0.210 -0.045" size="0.195 0.615">
                    <SmoothList id="cropList" size="100% 100%" visible="true">
                        <ListItem profile="yieldTrackerListItem" name="default" onClick="onClickCropSelected">
                            <Bitmap profile="selectCropRowImage" name="icon"/>
                            <Text profile="itemListText" name="cropListText" textAlignment="center" textVerticalAlignment="center" position="0 0" size="100% 100%"/>
                        </ListItem>
                    </SmoothList>
                    <Bitmap profile="verticalSeperator"/>
                </GuiElement>
            </GuiElement>

            <!-- RIGHT HALF: details + graph -->
            <GuiElement profile="yieldHistoryContainer" position="0.430 0.000" size="0.400 0.66">

                <GuiElement profile="statsBoxHeader" size="0.400 0.035" position="0.000 0.000">
                    <Button profile="taskListHeader" position="0.000 0.000" size="0.165 1" text="$l10n_yt_overviewLabel" textAlignment="center" handleFocus="false"/>
                    <Button profile="taskListHeader" position="0.175 0.000" size="0.095 1" text="$l10n_yt_yearLabel" textAlignment="center" handleFocus="false"/>
                    <Button profile="taskListHeader" position="0.275 0.000" size="0.125 1" text="$l10n_yt_totalYieldLabel" textAlignment="center" handleFocus="false"/>
                    <ThreePartBitmap profile="nonHighlightedSeperator"/>
                </GuiElement>

                <GuiElement id="yieldStatsInformation" size="0.400 0.615" position="0.000 -0.045" visible="true">

                    <RoundCorner profile="statsBox" id="shopMoneyBoxBg" position="0.000 0.000" size="0.165 0.300">
                        <Text profile="selectedFieldNumText" id="selectedFieldNumText" textVerticalAlignment="top"/>
                        <ThreePartBitmap profile="overviewNonHighlightedSeperator"/>

                        <Text profile="statsBoxLabels" position="0.015 -0.070" text="$l10n_yt_cropTypeLabel" textVerticalAlignment="top"/>
                        <Bitmap profile="statsBoxselectedCropIcon" id="selectedCropicon" position="0.015 -0.088"/>
                        <Text profile="statsBoxResults" id="selectedCropTypeText" position="0.027 -0.088" textVerticalAlignment="top"/>

                        <Text profile="statsBoxLabels" position="0.015 -0.130" text="$l10n_yt_totalHarvestsLabel" textVerticalAlignment="top"/>
                        <Text profile="statsBoxResults" id="selectedCropTotalHarvests" position="0.015 -0.148" textVerticalAlignment="top"/>

                        <Text profile="statsBoxLabels" position="0.015 -0.190" text="$l10n_yt_averageYearTitleLabel" textVerticalAlignment="top"/>
                        <Text profile="statsBoxResults" id="selectedCropAverageYield" position="0.015 -0.208" textVerticalAlignment="top"/>

                        <Text profile="statsBoxLabels" position="0.015 -0.250" text="$l10n_yt_bestYearLabel" textVerticalAlignment="top"/>
                        <Text profile="statsBoxResults" id="selectedCropBestYear" position="0.015 -0.268" textVerticalAlignment="top"/>
                    </RoundCorner>

                    <GuiElement profile="yieldListContainer" position="0.175 0.000" size="0.225 0.300">
                        <SmoothList id="yieldPerYearList" size="100% 100%" visible="true">
                            <ListItem profile="yieldTrackerListItem" name="default" allowSelected="false">
                                <Text profile="yieldStatItemListText" name="year" textAlignment="left" textVerticalAlignment="center" position="0.010 0" size="45% 100%"/>
                                <Text profile="yieldStatItemListText" name="yieldAmt" textAlignment="right" textVerticalAlignment="center" position="-0.010 0" size="100% 100%"/>
                            </ListItem>
                        </SmoothList>
                        <ThreePartBitmap profile="taskListGroupsSliderBox">
                            <Slider profile="fs25_listSlider" dataElementId="yieldPerYearList"/>
                        </ThreePartBitmap>
                    </GuiElement>

                    <Text profile="fs25_statisticsHeaderText" text="$l10n_yt_graphTitle" position="0.000 -0.335"/>

                    <GuiElement profile="fluctuationsGraph" id="barGraph" position="0.000 -0.375" size="0.400 0.230" hasFrame="true" frameThickness="1px 0px 0px 1px" frameLeftColor="0.4 0.4 0.4 1" frameBottomColor="0.4 0.4 0.4 1">
                        <Bitmap profile="graphCandleTemplate" id="graphCandleTemplate" visible="false"/>
                    </GuiElement>

                    <GuiElement profile="graphYearTickContainer" id="graphYearTickContainer" position="0.000 -0.610" size="0.400 0.030">
                        <Text profile="graphYearTickTemplate" id="graphYearTickTemplate" visible="false"/>
                    </GuiElement>
                </GuiElement>

                <Text profile="noYieldHistoryAlert" text="$l10n_yt_noYieldHistoryMsg" id="noYieldHistoryText" position="0.000 -0.100" size="100% 0.050" visible="false"/>
            </GuiElement>

        </GuiElement>
    </GuiElement>
</GUI>
